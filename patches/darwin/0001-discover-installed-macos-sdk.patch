+# xcrun supports both full Xcode and the Command Line Tools SDK layout.
+# An explicit installed SDK path keeps CI independent of Xcode's moving default.
+select_macos_sdk() {
+    OSX_SDK_ROOT="${EMULATOR_MACOS_SDK:-}"
+    if [ -z "$OSX_SDK_ROOT" ]; then
+        OSX_SDK_ROOT=$(xcrun --sdk macosx --show-sdk-path 2>/dev/null) || \
+            panic "No installed macOS SDK found through xcrun"
+    fi
+    if [ ! -f "$OSX_SDK_ROOT/SDKSettings.plist" ]; then
+        panic "Invalid macOS SDK path: $OSX_SDK_ROOT"
+    fi
+    OSX_SDK_VERSION=$(/usr/libexec/PlistBuddy -c 'Print :Version' "$OSX_SDK_ROOT/SDKSettings.plist") || \
+        panic "Cannot read installed macOS SDK version"
+    XCODE_PATH=$(xcode-select -print-path 2>/dev/null)
+    log "OSX: Using installed SDK $OSX_SDK_VERSION at $OSX_SDK_ROOT"
+}
